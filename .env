# Puerto en el que corre el servidor
PORT=3000

# Zona horaria usada para mostrar horarios y calcular recordatorios
TZ=America/Mexico_City

# --- Meta WhatsApp Cloud API ---
# Token de acceso permanente (o temporal) generado en Meta for Developers
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Number ID de tu numero de WhatsApp Business (NO es el numero telefonico)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Version de la Graph API que estas usando
WHATSAPP_API_VERSION=v20.0

# Nombre de la plantilla (template) aprobada en Meta Business Manager
# para el mensaje de confirmacion de cita. Debe tener 3 variables:
# {{1}} = nombre del paciente, {{2}} = fecha, {{3}} = hora
WHATSAPP_TEMPLATE_NAME=cita_confirmacion

# Codigo de idioma de la plantilla, tal como esta configurado en Meta
WHATSAPP_TEMPLATE_LANG=es_MX

# Lada/codigo de pais por defecto que se antepone si el telefono
# capturado no incluye codigo de pais (ej. 52 para Mexico)
DEFAULT_COUNTRY_CODE=52
